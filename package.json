{
  "name": "odap-gateway",
  "version": "0.3.0-preview.1",
  "private": false,
  "description": "Reference implementation of the ODAP Five Musts: a governed gateway for AI agents querying enterprise data, starting with BigQuery.",
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run --environment node",
    "test:native": "node scripts/native-d1-gate.mjs",
    "test:postgresql": "node node_modules/vitest/vitest.mjs run --config integrations/postgresql/vitest.config.ts",
    "postgresql:build": "tsc -p scripts/tsconfig.postgresql.json",
    "postgresql:check": "node dist/postgresql/integrations/postgresql/cli.js check",
    "postgresql:serve": "node dist/postgresql/integrations/postgresql/cli.js serve",
    "adapters:build": "tsc -p scripts/tsconfig.adapters.json",
    "adapters:inspect": "node dist/adapters/scripts/inspect-database-adapter.js",
    "evidence:build": "tsc -p scripts/tsconfig.evidence.json",
    "evidence:verify": "node dist/evidence/scripts/verify-settled-evidence.js",
    "evidence:verify-costs": "node dist/evidence/scripts/verify-auxiliary-cost-evidence.js",
    "evidence:verify-postgresql": "node dist/evidence/scripts/verify-postgresql-evidence.js",
    "evidence:export-openlineage": "node dist/evidence/scripts/export-openlineage.js",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "worker:dry-run": "npx wrangler deploy --config wrangler.example.jsonc --dry-run",
    "worker:deploy": "npx wrangler deploy --config wrangler.example.jsonc"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "clsx": "^2.1.1",
    "jsonc-parser": "3.3.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "node-sql-parser": "5.4.0",
    "pg": "8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.10.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.28.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "miniflare": "4.20260630.0",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "4.1.12",
    "wrangler": "^4.106.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "nanoid": "^3.3.18",
    "source-map-js": "1.2.2",
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "brace-expansion@<2": "1.1.22",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "Apache-2.0"
}
